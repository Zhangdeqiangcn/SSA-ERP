const applyMenuConfig = (groups, cfg) => {
  if (!cfg || !cfg.order && !cfg.visible) return groups;
  const order = cfg.order || {};
  const visible = cfg.visible || {};
  const byOrder = (a, b) => (order[a.path ?? ""] ?? 9999) - (order[b.path ?? ""] ?? 9999);
  return groups.map((g) => {
    const items = g.items.map((item) => {
      if (item.children) {
        const children = item.children.filter((c) => visible[c.path ?? ""] !== false).sort(byOrder);
        return children.length ? { ...item, children } : null;
      }
      if (visible[item.path ?? ""] === false) return null;
      return item;
    }).filter((x) => x !== null).sort(byOrder);
    return { ...g, items };
  }).filter((g) => g.items.length > 0);
};
