{"type":"before","callId":"call@424","startTime":111578.461,"class":"Frame","method":"evaluateExpression","params":{"expression":"() => {\n    const st = window.__ssaStores;\n    const t = {\n      id: 'e2e-st-1',\n      transferNo: 'ST-E2E-1',\n      fromWarehouseId: 'wh-001',\n      fromWarehouseName: '仓1',\n      toWarehouseId: 'wh-002',\n      toWarehouseName: '仓2',\n      status: 'draft',\n      transferDate: '2026-07-15',\n      items: [{\n        id: 'sti1',\n        materialId: 'mat-001',\n        materialCode: 'STEEL-001',\n        materialName: '钢板',\n        unit: 'kg',\n        quantity: 100\n      }],\n      createdAt: new Date().toISOString(),\n      updatedAt: new Date().toISOString(),\n      createdBy: 't',\n      updatedBy: 't'\n    };\n    st.useWarehouseAdvancedStore.getState().addStockTransfer(t);\n    st.useWarehouseAdvancedStore.getState().confirmTransfer(t.id);\n    const wh = st.useWarehouseStore.getState();\n    return {\n      out: wh.outboundOrders.some(o => o.sourceNo === 'ST-E2E-1' && o.type === 'transfer'),\n      in: wh.inboundOrders.some(o => o.sourceNo === 'ST-E2E-1' && o.type === 'transfer'),\n      completed: st.useWarehouseAdvancedStore.getState().stockTransfers.find(x => x.id === t.id).status === 'completed'\n    };\n  }","isFunction":true,"arg":{"value":{"v":"undefined"},"handles":[]}},"stepId":"pw:api@32","pageId":"page@5e7c1e231915d630c46bb40f97d66176","beforeSnapshot":"before@call@424"}
