{"type":"before","callId":"call@14","startTime":6639.353,"class":"Frame","method":"evaluateExpression","params":{"expression":"() => {\n      var _vis$;\n      const S = window.__ssaStores;\n      const po = S.usePurchaseStore.getState().purchaseOrders[0];\n      const item = po.items[0];\n      // 入库单实际过账到表单默认选中的仓库（当前组织下首个可见仓库），\n      // 与 InboundForm 的 visibleWarehouses[0] 行为一致；种子 PO 无 warehouseId 字段，\n      // 不能写死 'WH001'（实际仓库主数据 id 为 'wh-001'）。\n      const orgId = S.useOrgStore.getState().currentOrgId;\n      const whs = S.useWarehouseMasterStore.getState().warehouses;\n      const vis = whs.filter(w => !w.orgId || !orgId || w.orgId === orgId);\n      const wid = ((_vis$ = vis[0]) === null || _vis$ === void 0 ? void 0 : _vis$.id) || 'wh-001';\n      return {\n        orderNo: po.orderNo,\n        materialId: item.materialId || item.id,\n        warehouseId: wid,\n        qty: (item.orderedQuantity || 0) - (item.deliveredQuantity || 0)\n      };\n    }","isFunction":true,"arg":{"value":{"v":"undefined"},"handles":[]}},"stepId":"pw:api@37","pageId":"page@beda81bd42d58d0164fcdea3ba7e0d02","beforeSnapshot":"before@call@14"}
