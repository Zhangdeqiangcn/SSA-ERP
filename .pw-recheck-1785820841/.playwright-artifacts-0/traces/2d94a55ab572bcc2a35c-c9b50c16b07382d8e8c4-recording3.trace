{"type":"before","callId":"call@128","startTime":32590.624,"class":"Frame","method":"evaluateExpression","params":{"expression":"() => {\n      const st = window.__ssaStores.useWarehouseStore.getState();\n      const map = new Map();\n      st.inventoryRecords.forEach(r => {\n        if (r.warehouseId) map.set(r.warehouseId, r.warehouseName || r.warehouseId);\n      });\n      for (const [id, name] of map.entries()) {\n        if (st.inventoryRecords.filter(r => r.warehouseId === id).length > 0) return name;\n      }\n      return null;\n    }","isFunction":true,"arg":{"value":{"v":"undefined"},"handles":[]}},"stepId":"pw:api@34","pageId":"page@a52e45c128fc85a41e3753a228c4eed4","beforeSnapshot":"before@call@128"}
