{"type":"before","callId":"call@140","startTime":34748.017,"class":"Frame","method":"evaluateExpression","params":{"expression":"() => {\n      const st = window.__ssaStores.useWarehouseStore.getState();\n      const t = st.checkTasks[st.checkTasks.length - 1];\n      const first = t.items[0];\n      const r = st.inventoryRecords.find(x => x.materialId === first.materialId && x.locationId === first.locationId);\n      return {\n        taskId: t.id,\n        items: t.items.map(i => ({\n          book: i.bookQuantity,\n          materialId: i.materialId,\n          locationId: i.locationId\n        })),\n        beforeQty: r ? r.quantity : null\n      };\n    }","isFunction":true,"arg":{"value":{"v":"undefined"},"handles":[]}},"stepId":"pw:api@42","pageId":"page@a52e45c128fc85a41e3753a228c4eed4","beforeSnapshot":"before@call@140"}
