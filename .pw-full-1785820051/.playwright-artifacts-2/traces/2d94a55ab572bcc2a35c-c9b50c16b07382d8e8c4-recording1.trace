{"type":"before","callId":"call@64","startTime":139335.517,"class":"Frame","method":"evaluateExpression","params":{"expression":"() => {\n      const st = window.__ssaStores.useWarehouseStore.getState();\n      const map = new Map();\n      st.inventoryRecords.forEach(r => {\n        if (r.warehouseId) map.set(r.warehouseId, r.warehouseName || r.warehouseId);\n      });\n      for (const [id, name] of map.entries()) {\n        if (st.inventoryRecords.filter(r => r.warehouseId === id).length > 0) return name;\n      }\n      return null;\n    }","isFunction":true,"arg":{"value":{"v":"undefined"},"handles":[]}},"stepId":"pw:api@34","pageId":"page@b265a02a0f8480891a614da105972fed","beforeSnapshot":"before@call@64"}
