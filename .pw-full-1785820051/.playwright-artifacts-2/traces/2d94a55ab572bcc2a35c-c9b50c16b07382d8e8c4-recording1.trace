{"type":"before","callId":"call@76","startTime":141399.777,"class":"Frame","method":"evaluateExpression","params":{"expression":"() => {\n      const st = window.__ssaStores.useWarehouseStore.getState();\n      const t = st.checkTasks[st.checkTasks.length - 1];\n      const first = t.items[0];\n      const r = st.inventoryRecords.find(x => x.materialId === first.materialId && x.locationId === first.locationId);\n      return {\n        taskId: t.id,\n        items: t.items.map(i => ({\n          book: i.bookQuantity,\n          materialId: i.materialId,\n          locationId: i.locationId\n        })),\n        beforeQty: r ? r.quantity : null\n      };\n    }","isFunction":true,"arg":{"value":{"v":"undefined"},"handles":[]}},"stepId":"pw:api@42","pageId":"page@b265a02a0f8480891a614da105972fed","beforeSnapshot":"before@call@76"}
