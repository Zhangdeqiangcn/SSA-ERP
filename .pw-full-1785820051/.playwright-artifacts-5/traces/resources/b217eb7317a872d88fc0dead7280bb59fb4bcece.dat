function parseInvoice(text) {
  const pick = (label) => {
    const m = text.match(new RegExp(`${label}[：:]\\s*([^\\n]+)`));
    return m ? m[1].trim() : "";
  };
  const num = (label) => {
    const v = pick(label).replace(/[, ¥￥]/g, "");
    const n = parseFloat(v);
    return isNaN(n) ? 0 : n;
  };
  return {
    invoiceNo: pick("发票号码"),
    invoiceDate: pick("开票日期"),
    buyer: pick("购买方"),
    seller: pick("销售方"),
    amount: num("金额"),
    taxRate: pick("税率"),
    taxAmount: num("税额"),
    total: num("价税合计")
  };
}
